# === Supabase (obrigatório) ===
# Pegue em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"

# Usada só em rotas server-side / Edge Functions (NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# === App ===
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# === Web Push (VAPID) — Fase 3 ===
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# === Email (Resend) — Fase 3 ===
RESEND_API_KEY=""
EMAIL_FROM="Servir <avisos@seu-dominio.com>"
